rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GANTI dengan email Google supervisor (boleh lebih dari satu)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['EMAIL_SUPERVISOR@gmail.com'];
    }

    // Semua orang boleh melihat & mengirim request; hanya supervisor boleh ubah/hapus
    match /requests/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['requester','division','title','type','output','briefLink','deadline','createdAt'])
                    && request.resource.data.title is string && request.resource.data.title.size() < 200
                    && request.resource.data.notes.size() < 3000;
      allow update, delete: if isAdmin();
    }
    match /assignments/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if true; allow write: if isAdmin(); }
  }
}
